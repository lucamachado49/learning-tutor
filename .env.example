# Copie para .env e preencha as chaves (todas gratuitas).
# Provedores sem chave são pulados automaticamente.

# Ordem de tentativa no modo "auto"
LLM_ORDER=gemini,groq,ollama

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq → https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama local (fallback offline)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Mensagens anteriores enviadas ao LLM
HISTORY_LIMIT=20

# Whisper (STT)
WHISPER_MODEL_GPU=small
WHISPER_MODEL_CPU=base

# Voz: ordem dos motores
TTS_ORDER=kokoro,piper
