# Copie para .env e preencha as chaves (todas gratuitas).
# Provedores sem chave são pulados automaticamente.

# Ordem de tentativa no modo "auto"
LLM_ORDER=gemini,groq,ollama
# Ordem na conversa por voz (latência primeiro)
VOICE_LLM_ORDER=groq,gemini,ollama

# Google AI Studio → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Groq → https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Ollama local (fallback offline)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Mensagens anteriores enviadas ao LLM
HISTORY_LIMIT=20

# Whisper (STT)
WHISPER_MODEL_GPU=large-v3-turbo
WHISPER_MODEL_CPU=base

# Voz: ordem dos motores
TTS_ORDER=kokoro,piper

# Banco (PostgreSQL do docker compose)
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=tutor
POSTGRES_PORT=5434
DATABASE_URL=postgresql+psycopg://tutor:tutor@127.0.0.1:5434/tutor

# Logs: text ou json
LOG_LEVEL=INFO
LOG_FORMAT=text

# Biblioteca: modelo de embeddings no Ollama (ollama pull bge-m3)
EMBED_MODEL=bge-m3
RAG_TOP_K=6
